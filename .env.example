# SEC requires a descriptive User-Agent with contact info (https://www.sec.gov/os/accessing-edgar-data)
SEC_USER_AGENT="edgar-sentinel research agent (you@example.com)"

# Gemini (leave unset to run with --skip-llm)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash

# Gemma parser via local/Cloud Run Ollama (optional; fallback parser used when disabled)
GEMMA_ENABLED=false
OLLAMA_HOST=http://localhost:11434
GEMMA_MODEL=gemma3:4b

# Comma-separated default watchlist (CLI --tickers overrides)
WATCHLIST=AAPL,MSFT,NVDA
